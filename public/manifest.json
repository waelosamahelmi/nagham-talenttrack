  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "TalentTrack Dashboard"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "375x812",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "TalentTrack Mobile View"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View recruitment dashboard",
      "url": "/",
      "icons": [
        {
          "src": "/shortcut-dashboard.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Candidates",
      "short_name": "Candidates",
      "description": "Manage candidates",
      "url": "/candidates",
      "icons": [
        {
          "src": "/shortcut-candidates.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Interviews",
      "short_name": "Interviews",
      "description": "Schedule interviews",
      "url": "/interviews",
      "icons": [
        {
          "src": "/shortcut-interviews.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "/compose?to=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "text/csv": [".csv"],
        "application/vnd.ms-excel": [".xls"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"]
      }
    }
  ]
}
